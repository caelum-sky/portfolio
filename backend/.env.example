# Copy to .env for local dev — never commit the real .env

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-firebase-app.web.app

# ── SMTP (Gmail App Password) ─────────────────────────────────────────────────
# 1. Go to myaccount.google.com → Security → 2-Step Verification → App passwords
# 2. Generate an App Password for "Mail"
# 3. Paste it as SMTP_PASS below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=johndagooc2@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_TO_EMAIL=johndagooc2@gmail.com

# ── Misc ──────────────────────────────────────────────────────────────────────
UPLOAD_PIN=jsd-owner-2026
